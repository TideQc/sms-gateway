# Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================
# DATABASE CONFIGURATION
# ===========================
DB_HOST=db
DB_USER=user_sms
DB_PASS=your_secure_password_here
DB_NAME=sms_gateway

# ===========================
# JWT AUTHENTICATION
# ===========================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ===========================
# PIXEL 2 SMS GATEWAY
# ===========================
# IP address of your Android device on local network
PIXEL_IP=192.168.1.100

# Port configured in SMS Gateway app (default: 8080)
PIXEL_PORT=8080

# Credentials configured in SMS Gateway app
PIXEL_USER=admin
PIXEL_PASS=your_pixel_password

# Automatic unread SMS sync interval while at least one web client is connected (milliseconds)
# Default used by backend if omitted: 15000
PIXEL_AUTO_SYNC_INTERVAL_MS=15000

# If inbox endpoints are unsupported (404/sent-only), wait this long before retrying probes (milliseconds)
# Default: 300000 (5 minutes)
PIXEL_INBOX_UNSUPPORTED_RETRY_MS=300000

# Delay between each SMS in bulk sends (milliseconds)
# Backend default and enforced minimum: 1000
BULK_SMS_DELAY_MS=1000

# ===========================
# SERVER CONFIGURATION
# ===========================
# Backend API port (default: 3000)
PORT=3000

# Node environment (development, production)
NODE_ENV=development
